{
  "name": "websdk-component-demo",
  "version": "6.5.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "dependencies": {
    "@zoom/meetingsdk": "6.5.0",
    "lodash": "^4.18.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-redux": "8.1.3",
    "redux": "4.2.1",
    "redux-thunk": "2.4.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/cz-commitlint": "^21.2.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "commitizen": "^4.3.2",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "lodash": "^4.18.1",
    "mkdirp": "^3.0.1",
    "ncp": "^2.0.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "regenerator-runtime": "^0.14.1",
    "rimraf": "^6.1.3",
    "sass": "^1.104.1",
    "sass-loader": "^17.0.1",
    "stylelint": "^17.15.0",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "targz": "^1.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-svgr": "^5.2.0"
  },
  "husky": {
    "hooks": {
      "prepare-commit-msg": "exec < /dev/tty && npx cz --hook || true"
    }
  },
  "license": "MIT",
  "lint-staged": {
    "{src,test}/**/*.{js,jsx,ts,tsx}": [
      "oxfmt --write",
      "oxlint --max-warnings 0"
    ],
    "{src,test}/**/*.json": [
      "oxfmt --write"
    ]
  },
  "private": true,
  "scripts": {
    "postinstall": "node postinstall.js",
    "build": "tsc && vite build",
    "commit": "cz",
    "start": "node script.js && vite",
    "lint": "oxlint --max-warnings 0 --report-unused-disable-directives ./src",
    "lint:fix": "oxlint --fix --max-warnings 0 ./src",
    "lint:style": "stylelint **/*.scss --max-warnings 4000",
    "prepare": "cd .. && husky Components/.husky",
    "preview": "vite preview",
    "stylelint": "npx stylelint \"**/*.scss\"",
    "format": "oxfmt --write src vite.config.ts",
    "format:check": "oxfmt --check src vite.config.ts"
  }
}